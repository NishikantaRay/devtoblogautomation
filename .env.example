# DEV.to API key used by the scheduler worker to publish queued posts.
# Get one at https://dev.to/settings/extensions
# Copy this file to .env.local and fill in your key.
DEVTO_API_KEY=

# Optional: override where the schedule is stored.
# Defaults to .data/schedule.json in the project root.
# SCHEDULE_FILE=

# Optional: override the DEV.to API endpoint (used for local testing).
# DEVTO_API_URL=
